# ============================================================================
# GUIDESOFT Full-Stack Environment Configuration
# Copy this file to .env and configure for your deployment environment.
# Never commit real secrets to version control.
# ============================================================================

# --- Supabase Database & Auth (Backend & Server-side only) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Cashfree Payments Gateway (Sandbox & Production) ---
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_WEBHOOK_SECRET=your-cashfree-webhook-secret
CASHFREE_ENV=sandbox

# --- Server & CORS Configuration ---
FRONTEND_URL=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:8000
VITE_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://guideitsol.com

# --- Admin Security ---
# Sent by Admin Console in the `X-Admin-Key` header
ADMIN_API_KEY=test-admin-key

# --- Transactional Email (Optional SMTP) ---
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=GUIDESOFT <no-reply@guideitsol.com>
EMAIL_ADMIN_TO=info@guideitsol.com
