# ============================================================================
# GUIDESOFT Full-Stack Environment Configuration
# Canonical production domain: https://www.guideitsol.com
# Alternate (redirects to canonical): https://www.guideitsol.in
#
# SECURITY: never commit live gateway keys, SMTP passwords or the admin key in
# this file for production. Set them in your host's environment/secret store
# and keep only non-secret public values here.
# ============================================================================

# --- Brand & Public URLs ---
# Canonical host used for meta tags, canonical links, sitemap and share cards.
VITE_SITE_URL=https://www.guideitsol.com
VITE_SITE_DOMAIN=guideitsol.com
# Secondary host kept alive and 301-redirected to the canonical domain.
VITE_SITE_ALTERNATE_URL=https://www.guideitsol.in
FRONTEND_URL=https://www.guideitsol.com
# Point this at the deployed FastAPI service (e.g. https://api.guideitsol.com).
# Deployments on the same origin can leave it relative and proxy /api/* instead.
PUBLIC_API_BASE_URL=http://localhost:8000
VITE_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://guideitsol.com,https://www.guideitsol.com,https://guideitsol.in,https://www.guideitsol.in,https://guideitsol-frontend-forge-main.vercel.app

# --- Real-Time UPI & GPAY Payment Gateway ---
VITE_UPI_VPA=Q166755499@ybl
VITE_UPI_PAYEE_NAME=GuideSoft IT Solutions and Trainings
VITE_UPI_MERCHANT_CODE=5499
VITE_ENABLE_LIVE_UPI=true

# --- Google OAuth & Authorization ---
VITE_GOOGLE_CLIENT_ID=881234567890-guideitsol.apps.googleusercontent.com
VITE_AUTH_DOMAIN=auth.guideitsol.in

# --- Cashfree Payments Gateway (Optional Backend Gateway) ---
CASHFREE_APP_ID=cf_app_live_guideitsol
CASHFREE_SECRET_KEY=cf_sec_live_guideitsol
CASHFREE_ENV=production

# --- Admin Security ---
ADMIN_API_KEY=guideitsol-admin-secure-key-2026

# --- Transactional Email ---
EMAIL_FROM=GUIDESOFT <admissions@guideitsol.in>
EMAIL_ADMIN_TO=info@guideitsol.in

# --- Supabase (Real Auth) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
